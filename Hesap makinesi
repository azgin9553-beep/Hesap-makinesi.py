import math
import os

while True:
    os.system("cls" if os.name == "nt" else "clear")

    print("=" * 35)
    print("     🧮 PYTHON HESAP MAKİNESİ")
    print("=" * 35)
    print("1 - Toplama (+)")
    print("2 - Çıkarma (-)")
    print("3 - Çarpma (*)")
    print("4 - Bölme (/)")
    print("5 - Üs Alma (^)")
    print("6 - Karekök (√)")
    print("7 - Mod (%)")
    print("0 - Çıkış")
    print("=" * 35)

    secim = input("Seçimin: ")

    if secim == "0":
        print("Program kapatıldı.")
        break

    if secim == "6":
        sayi = float(input("Sayı: "))
        if sayi < 0:
            print("Negatif sayının karekökü alınamaz!")
        else:
            print("Sonuç:", math.sqrt(sayi))
    else:
        s1 = float(input("1. Sayı: "))
        s2 = float(input("2. Sayı: "))

        if secim == "1":
            print("Sonuç:", s1 + s2)

        elif secim == "2":
            print("Sonuç:", s1 - s2)

        elif secim == "3":
            print("Sonuç:", s1 * s2)

        elif secim == "4":
            if s2 == 0:
                print("0'a bölünemez!")
            else:
                print("Sonuç:", s1 / s2)

        elif secim == "5":
            print("Sonuç:", s1 ** s2)

        elif secim == "7":
            print("Sonuç:", s1 % s2)

        else:
            print("Geçersiz seçim!")

    input("\nDevam etmek için Enter'a bas...")
